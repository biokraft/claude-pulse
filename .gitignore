.DS_Store
bin/
dist/
# Connect IQ exports. Kept out of dist/, which goreleaser wipes on every run.
build/
*.prg
*.prg.debug.xml
gen/
developer_key*
*.pem
relay/claude-pulse-relay

# Local tooling and planning artifacts
.claude/
.superpowers/
.screenshots/
docs/superpowers/
docs/ip-trademark-findings.md
PRD.md

# Generated by scripts/shoot-pages.sh for screenshot builds; deleted in its
# EXIT trap, but a SIGKILL (or a crashed simulator) skips the trap and would
# otherwise leave fake seed data staged for commit.
watch/source/_ScreenshotSeed.mc

# Beta Connect IQ app id. Machine-local: a second 32-char hex id in a tracked
# file trips scripts/check-no-leaks.sh, and only the owner publishes betas.
watch/.beta-app-id
watch/.dev-app-id

# Playwright MCP session dumps (page snapshots, console logs) — scratch, and
# they carry third-party URLs and ids.
.playwright-mcp/
