{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "include-component-in-tag": false,
  "bump-minor-pre-major": false,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "release-type": "go"
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "refactor",
      "section": "Changed"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "chore",
      "hidden": true
    },
    {
      "type": "test",
      "hidden": true
    },
    {
      "type": "ci",
      "hidden": true
    }
  ]
}
